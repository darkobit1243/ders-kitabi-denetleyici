.venv/
*.pyc
.onbellek/

# Ders kitabı PDF'leri (telif hakkı MEB'e ait) depoya yüklenmez,
# sadece kendi oluşturduğumuz test PDF'i yüklenir.
ornekler/*.pdf
# Programla birlikte verilen, bilinçli hatalar içeren deneme kitapları ve cevap anahtarı
!ornekler/Örnek Kitap - *.pdf
!ornekler/cevap_anahtari/

# Program çıktısı olan raporlar
rapor_*.csv
bulgular_*.csv

# Arayuze yuklenen PDF dosyalari
.yuklenenler/

# Cevrimdisi kurulum paketleri (paketleri_hazirla.bat ile olusturulur)
paketler/
denetim_raporu_*.html

# Program calisma gunlugu
hata_gunlugu.txt
